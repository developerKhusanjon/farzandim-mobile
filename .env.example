# Lokal sozlama uchun .env.local yarating (git'ga kirmaydi), keyin ilovani qayta yuklang

# mobile-backend manzili (oxiri /api/v1)
#   iOS simulyatori:   http://localhost:8082/api/v1   (standart, .env.development)
#   Android emulyator: http://10.0.2.2:8082/api/v1
#   Telefon (Wi-Fi):   http://<kompyuter IP manzili>:8082/api/v1
#                      backend'ni -Dquarkus.http.host=0.0.0.0 bilan ishga tushiring
EXPO_PUBLIC_API_URL=http://localhost:8082/api/v1

# Backend'siz mock rejimi (npm run start:mock o'zi yoqadi)
# EXPO_PUBLIC_USE_MOCK=true
